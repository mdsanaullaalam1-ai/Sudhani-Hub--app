# SudhaniHub Environment Configuration
PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sudhanihub

# JWT Authentication
JWT_SECRET=sudhani_super_secret_jwt_key_2025
JWT_EXPIRES_IN=30d

# Razorpay Payment Integration (Ready)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Cloudinary Image Storage (Ready)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Google Maps API (Ready)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Firebase Cloud Messaging (Ready)
FIREBASE_SERVER_KEY=your_firebase_fcm_key
